// ========================================
// LOGÍSTICA
// ========================================

enum DeliveryRouteStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DeliveryStopType {
  DELIVERY
  PICKUP
}

enum DeliveryStopTransport {
  OWN
  THIRD_PARTY
}

enum DeliveryStopZone {
  CABA
  NORTE
  SUR
  OESTE
}

enum DeliveryStopStatus {
  PENDING
  PREPARING
  IN_ROUTE
  DELIVERED
  NOT_DELIVERED
  PICKED_UP
  NOT_PICKED_UP
}

model DeliveryRoute {
  id     String              @id @default(cuid())
  date   DateTime
  status DeliveryRouteStatus @default(PLANNING)
  notes  String?             @db.Text

  createdById String
  createdBy   User   @relation("UserDeliveryRoutes", fields: [createdById], references: [id])

  stops DeliveryStop[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([status])
  @@index([createdById])
  @@map("delivery_routes")
}

model DeliveryStop {
  id      String        @id @default(cuid())
  routeId String
  route   DeliveryRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  deliveryNoteId String?
  deliveryNote   DeliveryNote? @relation(fields: [deliveryNoteId], references: [id])

  order Int // Posición en la ruta
  type  DeliveryStopType @default(DELIVERY)

  customerName     String
  transportType    DeliveryStopTransport @default(OWN)
  transportName    String? // Nombre transporte tercerizado
  transportAddress String? // Dirección del transporte/expreso
  transportPhone   String? // Teléfono del transporte

  address String?
  city    String?
  zone    DeliveryStopZone @default(CABA)

  schedule     String? // Horario recepción (texto libre)
  contactName  String?
  contactPhone String?

  packages         String  @default("")
  finalDestination String? // Destino interior si aplica

  trackingNumber   String? // Número de guía
  deliveryDeadline DateTime? // Fecha compromiso entrega

  observations String? @db.Text

  // Retiros de proveedores
  supplierId          String?
  supplier            Supplier? @relation(fields: [supplierId], references: [id])
  materialDescription String?   @db.Text // Material a retirar

  status      DeliveryStopStatus @default(PENDING)
  completedAt DateTime?
  signature   String? // URL foto/firma

