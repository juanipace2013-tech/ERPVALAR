// ========================================
// BANDEJA UNIFICADA (Mail + WhatsApp)
// ========================================

enum ChannelType {
  WHATSAPP
  EMAIL
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  DRAFT
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

enum MessageCategory {
  COTIZACION
  CONSULTA
  QUEJA
  PAGO
  OTRO
  EXIROS_LICITACION // mails de bidding-no-reply@exiros.com — se gestionan desde /exiros
}

// Cuenta del canal en nuestro lado: nuestro número de WhatsApp o nuestra casilla de mail.
// Permite tener múltiples en el futuro (ej: ventas@ y postventa@).
model ChannelAccount {
  id         String      @id @default(cuid())
  type       ChannelType
  name       String // "Ventas Val Arg WhatsApp", "ventas@val-ar.com.ar"
  // WhatsApp: phone_number_id de Meta. Email: UPN del buzón (ej: ventas@val-ar.com.ar)
  identifier String
  isActive   Boolean     @default(true)
  // metadata no sensible — los secretos viven en .env
  metadata   Json?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  conversations Conversation[]

  @@unique([type, identifier])
  @@map("channel_accounts")
}

model Conversation {
  id               String         @id @default(cuid())
  channelAccountId String
  channelAccount   ChannelAccount @relation(fields: [channelAccountId], references: [id])

  // Identificador externo de la conversación en el canal
  // WhatsApp: teléfono E.164 del contacto
  // Email: conversationId de Microsoft Graph (thread)
  externalId String

  // Display
  contactName       String?
  contactIdentifier String // teléfono o email del contacto
  subject           String? // solo email

  // Matching CRM
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  contactId  String?
  contact    Contact?  @relation(fields: [contactId], references: [id])

  // Estado
  status        ConversationStatus @default(OPEN)
  unreadCount   Int                @default(0)
  lastMessageAt DateTime?

  // Asignación
  assignedToId String?
  assignedTo   User?   @relation("AssignedConversations", fields: [assignedToId], references: [id])

  // IA — última clasificación + borrador (Fase 2). Sin historial: se sobrescribe.
  aiCategory           MessageCategory?
  aiCategoryConfidence Float? // 0..1
  aiSummary            String?          @db.Text
  aiDraftReply         String?          @db.Text
  aiClassifierModel    String?
  aiDrafterModel       String?
  aiCostUsd            Decimal?         @db.Decimal(10, 6)
  aiAnalyzedAt         DateTime?
  aiAnalyzedMessageId  String? // id del Message más reciente sobre el que se hizo el análisis

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@unique([channelAccountId, externalId])
  @@index([customerId])
  @@index([contactId])
  @@index([status])
  @@index([assignedToId])
  @@index([lastMessageAt])
  @@index([aiCategory])
  @@index([aiAnalyzedAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // ID del mensaje en el canal (wamid.* para WA, id de Graph para mail)
  externalId String? @unique

  direction MessageDirection
  status    MessageStatus    @default(RECEIVED)

  // Contenido
  body        String  @db.Text
  bodyHtml    String? @db.Text // mail (HTML body)
  // Lista de adjuntos: [{ filename, contentType, size, externalId?, url? }]
  attachments Json?

  // Sender
  fromName    String?
  fromAddress String // teléfono o email

  // Hilo (solo mail)
  inReplyToExternalId String?

  // Si lo enviamos nosotros
  sentByUserId String?
  sentByUser   User?   @relation("MessageSentByUser", fields: [sentByUserId], references: [id])

  // Cuándo ocurrió en el canal
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([conversationId])
  @@index([createdAt])
  @@map("messages")
}

// Tracking de las subscriptions de Microsoft Graph (webhooks de mail).
// Las subscriptions de /messages caducan a las ~70hs, hay que renovarlas con cron.
model GraphSubscription {
  id              String   @id @default(cuid())
  subscriptionId  String   @unique // el ID que devuelve Graph
  resource        String // ej "users/ventas@val-ar.com.ar/messages"
  changeType      String // "created"
  notificationUrl String
  clientState     String // secreto compartido para validar callbacks
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([expiresAt])
  @@map("graph_subscriptions")
}

// ============================================================================
// MERCADO LIBRE — Mensajería post-venta
// ============================================================================
// Flujo: ML manda un webhook (topic "orders"/"orders_v2") -> guardamos la
// notificación cruda -> el handler trae la orden, matchea una regla por SKU/item
// y, según el modo, deja el mensaje en revisión o lo manda solo (motivo OTHER
// del action_guide). Ver src/lib/mercadolibre/*.

enum MlMessageMode {
  AUTO // se envía solo apenas entra la orden paga
  REVIEW // queda pendiente y Santiago lo dispara con un click
}

enum MlPostSaleStatus {
  PENDING_REVIEW // modo REVIEW: armado, esperando envío manual
  SENT // enviado OK
  MODERATED // ML lo moderó/rechazó — NO se reintenta
  FAILED // error de API — logueado
  SKIPPED // no había cap_available para OTHER
}

enum MlQuestionStatus {
  PENDING_REVIEW // borrador generado por IA, esperando aprobación
  ANSWERED // respondida en ML (manual o AUTO)
  FAILED // error de API al responder — se puede reintentar
  DISMISSED // descartada desde la UI (se responde por fuera o no aplica)
  CLOSED // ML la cerró (borrada por el comprador / ítem pausado) antes de responder
}

// Credenciales OAuth de la cuenta de VAL ARG en ML. Una sola fila.
// El refresh_token de ML es de un solo uso: cada refresh devuelve uno nuevo
// que hay que persistir. Ver getValidAccessToken en client.ts.
model MlCredential {
  id           String   @id @default(cuid())
  mlUserId     BigInt   @unique // id del seller (VAL ARG)
  accessToken  String   @db.Text
  refreshToken String   @db.Text
  expiresAt    DateTime // cuándo vence el access_token
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("ml_credentials")
}

// Log/cola cruda de notificaciones del webhook. Sirve para dedupe y auditoría.
model MlNotification {
  id         String   @id @default(cuid())
  topic      String // "orders", "orders_v2", ...
  resource   String // ej "/orders/123"
  mlUserId   BigInt? // user_id del payload
  receivedAt DateTime @default(now())
  processed  Boolean  @default(false)
  attempts   Int      @default(0)

  @@index([processed])
  @@index([resource])
  @@map("ml_notifications")
}

// Regla que decide qué mensaje mandar para qué producto. Matchea si mlItemId
// O sellerSku coinciden con algún item de la orden.
model MlMessageRule {
  id          String        @id @default(cuid())
  enabled     Boolean       @default(true)
  mlItemId    String? // ej "MLA123456789"
  sellerSku   String? // ej "3318 05 + 3821"
  messageText String        @db.VarChar(350)
  mode        MlMessageMode @default(REVIEW)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  postSaleMessages MlPostSaleMessage[]

  @@index([enabled])
  @@index([mlItemId])
  @@index([sellerSku])
  @@map("ml_message_rules")
}

// Un mensaje post-venta por orden/pack. El UNIQUE en packId es la idempotencia:
// garantiza que nunca se procese dos veces la misma conversación.
model MlPostSaleMessage {
  id               String           @id @default(cuid())
  packId           String           @unique
  orderId          String
  ruleId           String?
  rule             MlMessageRule?   @relation(fields: [ruleId], references: [id])
  status           MlPostSaleStatus @default(PENDING_REVIEW)
  mlMessageId      String? // id del mensaje en ML una vez enviado
  moderationReason String?
  text             String           @db.VarChar(350)
  createdAt        DateTime         @default(now())
  sentAt           DateTime?

  @@index([status])
  @@index([orderId])
  @@map("ml_post_sale_messages")
}

// Pregunta pre-venta recibida en una publicación. UNIQUE en mlQuestionId =
// idempotencia. El borrador lo genera Claude con contexto del ítem + producto
// del ERP; en modo REVIEW queda PENDING_REVIEW hasta que alguien lo aprueba.
model MlQuestion {
  id            String           @id @default(cuid())
  mlQuestionId  BigInt           @unique
  mlItemId      String // "MLA123..."
  itemTitle     String?
  itemSku       String? // seller_sku / seller_custom_field de la publicación
  productId     String?
  product       Product?         @relation(fields: [productId], references: [id])
  buyerId       BigInt?
  questionText  String           @db.Text
  askedAt       DateTime? // date_created en ML
  status        MlQuestionStatus @default(PENDING_REVIEW)
  draftAnswer   String?          @db.Text // propuesta de la IA (editable)
  answerText    String?          @db.Text // lo que efectivamente se publicó
  answeredAt    DateTime?
  answeredById  String?
  needsReview   Boolean          @default(false) // la IA pidió revisión humana
  reviewReason  String?
  errorDetail   String?
  aiModel       String?
  aiCostUsd     Decimal?         @db.Decimal(10, 6)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status])
  @@index([mlItemId])
  @@map("ml_questions")
}

// ============================================================================
// EXIROS — Licitaciones (Bidding Point)
// ============================================================================
// Un agente Python externo (corre en el mismo VPS, fuera del ERP) detecta
// licitaciones nuevas en el portal de Exiros, las clasifica con IA y las
// pushea acá vía POST /api/exiros/sync (auth: Bearer EXIROS_AGENT_API_KEY).
// El decline es asíncrono: la UI encola (estado DECLINAR_PENDIENTE), el agente
// las levanta con GET /api/exiros/acciones, ejecuta el decline en el portal y
// reporta el resultado con PATCH /api/exiros/acciones.

// Licitación detectada por el agente (multi-plataforma: Exiros y SAP Ariba de
// Pampa Energía). El upsert del agente NUNCA pisa `estado` si ya no es NUEVA
// (respeta las decisiones tomadas desde la UI).
model ExirosLicitacion {
  id           String    @id @default(cuid())
  numero       String    @unique // número público, ej "5344579" (Exiros) o "PR443348" (Ariba)
  plataforma   String    @default("EXIROS") // EXIROS | ARIBA_PAMPA (extensible)
  idInterno    Int? // id interno del Bidding Point de Exiros (para el deep-link)
  linkPortal   String? // URL directa al evento (Ariba la trae en el mail; Exiros usa idInterno)
  titulo       String
  empresa      String? // EXIROS / TENARIS / TERNIUM / TECHINT / TECPETROL / PAMPA ENERGIA
  comprador    String?
  clienteFinal String? // deducido de los ítems (ej "Tecpetrol/Yac. Fortín")
  cierre       DateTime?
  veredicto    String // COTIZAR | REVISAR | DECLINAR
  confianza    Int?
  razon        String?   @db.Text
  estado       String    @default("NUEVA")
  // NUEVA | EN_PROCESO | COTIZADA | DECLINAR_PENDIENTE | DECLINADA | DECLINE_ERROR | IGNORADA | VENCIDA
  origen       String? // "mail" | "sweep"
  declineMsg   String?   @db.Text // resultado del decline reportado por el agente

  items ExirosItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estado])
  @@index([veredicto])
  @@index([empresa])
  @@index([cierre])
  @@index([plataforma])
  @@map("exiros_licitaciones")
}

model ExirosItem {
  id             String           @id @default(cuid())
  licitacionId   String
  licitacion     ExirosLicitacion @relation(fields: [licitacionId], references: [id], onDelete: Cascade)
  nro            Int
  descCorta      String
  descLarga      String?          @db.Text
  cantidad       Float?
  unidad         String?
  cliente        String?
  fechaRequerida DateTime?
  quePide        String? // resumen IA en criollo de qué están pidiendo
  match          String? // sugerencia IA: "GENEBRE art.2034" / "fuera de rubro" / etc.

  @@index([licitacionId])
  @@map("exiros_items")
}

// ========================================
// COMISIONES DE VENDEDORES
// ========================================

enum TipoOperacionComision {
  BILLETE // el cliente paga en pesos → TC billete del mes
  DIVISA // el cliente paga en dólares (transferencia) → TC divisa del mes
}

enum EstadoComisionLinea {
  CERRADO // cotización aprobada sin facturar: forecast, solo USD, no se paga
  FACTURADO // facturado: entra en la liquidación del mes (tasa provisoria)
  LIQUIDADO // incluido en una liquidación cerrada: tasa y montos congelados
}

enum EstadoComisionLiquidacion {
  ABIERTA // borrador: las líneas se recalculan con el tramo provisorio
  CERRADA // cerrada: tasaAplicada y montos congelados en cada línea
}

// Escala mensual de comisión. El TOTAL facturado USD del mes define un único
// tramo que se aplica a TODAS las ventas facturadas de ese mes (no es por
// venta). Bordes: piso inclusivo, techo exclusivo → [50000, 75000) = 1,25%.
// Seed constante; versionable a futuro vía vigenteDesde.
model ComisionEscala {
  id           Int      @id @default(autoincrement())
  pisoUsd      Decimal  @db.Decimal(15, 2)
  techoUsd     Decimal? @db.Decimal(15, 2) // null = sin techo (último tramo)
  tasa         Decimal  @db.Decimal(6, 4) // 0.01, 0.0125, 0.015, 0.02
  vigenteDesde DateTime @default(now())

  @@map("comision_escalas")
}

model VendedorComisionConfig {
  id         String   @id @default(cuid())
  vendedorId String   @unique
  basicoArs  Decimal  @db.Decimal(15, 2) // básico mensual fijo en ARS
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  vendedor User @relation(fields: [vendedorId], references: [id])

  @@map("vendedor_comision_configs")
}

// Tipo de cambio USD→ARS del mes para liquidar comisiones. Un valor por
// tipo de operación (la planilla original usaba TC distinto según cómo
// pagaba el cliente: billete vs divisa).
model TipoCambioMes {
  id        Int      @id @default(autoincrement())
  anio      Int
  mes       Int // 1-12
  billete   Decimal  @db.Decimal(12, 4)
  divisa    Decimal  @db.Decimal(12, 4)
  updatedAt DateTime @updatedAt

  @@unique([anio, mes])
  @@map("tipo_cambio_meses")
}

// Línea de comisión. Se materializa en dos casos:
//   1. Migración de planillas históricas (estado LIQUIDADO/CERRADO, sin
//      vínculos al ERP: la numeración de presupuestos vieja no existe acá).
//   2. Al abrir/refrescar una liquidación: snapshot de las CotizacionFactura
//      del mes del vendedor (estado FACTURADO → LIQUIDADO al cerrar).
// El forecast en vivo (pipeline de cotizaciones aprobadas) NO se
// materializa: se calcula on-the-fly desde Quote/CotizacionFactura.
model ComisionLinea {
  id            String  @id @default(cuid())
  vendedorId    String
  liquidacionId String?

  // Datos denormalizados: histórico de planilla, o snapshot al liquidar
  clienteNombre String
  presupuesto   String // número de presupuesto (formato viejo o VAL-YYYY-NNN)
  numeroFactura String? // "S/F" en planilla = sin factura asignada aún
  fecha         DateTime? // fecha de la NC manual; las líneas de factura usan facturaParcial.fecha

  // Vínculos best-effort al ERP (null para históricos pre-ERP)
  clienteId        String?
  cotizacionId     String?
  facturaParcialId String? // CotizacionFactura origen del snapshot

  importeCerradoUsd   Decimal? @db.Decimal(15, 2) // USD de la cotización aprobada
  importeFacturadoUsd Decimal? @db.Decimal(15, 2) // USD facturado (por factura)

  tipoOperacion  TipoOperacionComision @default(BILLETE)
  tipoCambio     Decimal?              @db.Decimal(12, 4) // TC aplicado a esta línea
  anioImputacion Int?
  mesImputacion  Int? // mes de la factura

  estado       EstadoComisionLinea @default(FACTURADO)
  tasaAplicada Decimal?            @db.Decimal(6, 4) // se congela al cerrar la liquidación
  comisionUsd  Decimal?            @db.Decimal(15, 2)
  comisionArs  Decimal?            @db.Decimal(15, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendedor       User                 @relation(fields: [vendedorId], references: [id])
  liquidacion    ComisionLiquidacion? @relation(fields: [liquidacionId], references: [id])
  cotizacion     Quote?               @relation(fields: [cotizacionId], references: [id])
  facturaParcial CotizacionFactura?   @relation(fields: [facturaParcialId], references: [id])

  @@index([vendedorId])
  @@index([liquidacionId])
  @@index([anioImputacion, mesImputacion])
  @@index([estado])
  @@index([facturaParcialId])
  @@map("comision_lineas")
}

model ComisionLiquidacion {
  id         String @id @default(cuid())
  vendedorId String
  anio       Int
  mes        Int // 1-12

  estado EstadoComisionLiquidacion @default(ABIERTA)

  totalFacturadoUsd Decimal  @default(0) @db.Decimal(15, 2)
  tasaMes           Decimal? @db.Decimal(6, 4) // tramo según totalFacturadoUsd
  basicoArs         Decimal  @default(0) @db.Decimal(15, 2)
  comisionesArs     Decimal  @default(0) @db.Decimal(15, 2)
  // neto = basicoArs + comisionesArs + Σ ajustes.montoArs (ajustes con signo)
  netoArs           Decimal  @default(0) @db.Decimal(15, 2)

  // Split del pago (inputs manuales)
  efectivoArs Decimal? @db.Decimal(15, 2)
  mlArs       Decimal? @db.Decimal(15, 2)

  notas     String?   @db.Text
  cerradaEn DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  vendedor User             @relation(fields: [vendedorId], references: [id])
  ajustes  ComisionAjuste[]
  lineas   ComisionLinea[]

  @@unique([vendedorId, anio, mes])
  @@index([anio, mes])
  @@map("comision_liquidaciones")
}

// Concepto manual con signo (ej: "Deuda Germán" -100611, "Sommier Center"
// -613635.56). Negativo resta del neto.
model ComisionAjuste {
  id            String   @id @default(cuid())
  liquidacionId String
  concepto      String
  montoArs      Decimal  @db.Decimal(15, 2)
  createdAt     DateTime @default(now())

  liquidacion ComisionLiquidacion @relation(fields: [liquidacionId], references: [id], onDelete: Cascade)

  @@index([liquidacionId])
  @@map("comision_ajustes")
}

// ========================================
// HERRAMIENTAS TÉCNICAS
// ========================================

// Historial compartido de cálculos de la calculadora de reguladora de
// vapor (GENEBRE 2274/2275). Se guardan las entradas y un resumen del
// resultado; el detalle completo (tablas, banda) se recalcula al vuelo
// porque la fórmula es determinística.
model CalculoReguladoraVapor {
  id                String   @id @default(cuid())
  p1                Float
  p2                Float
  q                 Float
  cliente           String?
  referencia        String?
  regimen           String // SUBCRÍTICO | CRÍTICO
  cvCalculado       Float
  medida            String? // null = fuera de rango
  porcentajeTrabajo Float?
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@map("calculos_reguladora_vapor")
}
