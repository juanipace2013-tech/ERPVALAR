# Google Ads Lead Form Extensions webhook
# Clave secreta compartida con Google Ads (campo google_key del payload)
GOOGLE_ADS_WEBHOOK_KEY=""

# ─── Bandeja: WhatsApp Cloud API (Meta) ───────────────────────────────────────
# Alta en https://developers.facebook.com -> WhatsApp -> Configuration
# Necesitamos un número verificado de WhatsApp Business y la app de Meta con
# producto "WhatsApp" agregado. El webhook se configura para que apunte a
# {APP_URL}/api/webhooks/whatsapp con el verify token de abajo.
META_WHATSAPP_VERIFY_TOKEN=""    # token arbitrario que elegimos nosotros
META_WHATSAPP_APP_SECRET=""      # App Secret de la app de Meta (HMAC signature)
META_WHATSAPP_ACCESS_TOKEN=""    # Bearer permanente (System User token) — para enviar
META_WHATSAPP_PHONE_NUMBER_ID="" # phone_number_id del número desde el dashboard

# ─── Bandeja: Microsoft Graph (mail entrante) ────────────────────────────────
# Reutiliza las credenciales AZURE_* de arriba. La App Registration de Azure
# necesita el permiso adicional "Mail.Read" (application permission) con
# admin consent. Para que Graph mande webhooks, APP_URL debe ser HTTPS público
# (en dev: ngrok / cloudflared / Cloudflare tunnel).
GRAPH_WEBHOOK_CLIENT_STATE=""    # secreto compartido que Graph nos devuelve en cada notificación
APP_URL=""                       # URL pública del CRM (https://...) — Graph rechaza localhost

# ─── Bandeja: Agente IA (Anthropic) ───────────────────────────────────────────
# Key DEDICADA del agente de bandeja (clasificador Haiku + drafter Sonnet).
# ⚠️  IMPORTANTE: NO reutilizar ANTHROPIC_API_KEY (esa es del OCR de facturas).
# Creá una key nueva en https://console.anthropic.com/ con un nombre tipo
# "Agente bandeja VAL ARG" y pegala acá. Las dos keys pueden ser de la misma
# organización — solo queremos separarlas para cuotas, métricas y rotación
# independiente.
INBOX_AGENT_API_KEY=""

# ─── Mercado Libre: Mensajería post-venta ─────────────────────────────────────
# Alta de la app en https://developers.mercadolibre.com.ar/devcenter
# El access/refresh token inicial se obtiene con el flujo OAuth y se carga a mano
# en la tabla ml_credentials (una sola fila, la cuenta de VAL ARG). De ahí en
# más el cliente refresca solo (el refresh_token es de un solo uso, lo persiste).
# El webhook se registra en la app apuntando a {APP_URL}/api/webhooks/mercadolibre
# y suscribiendo el topic "orders_v2".
ML_CLIENT_ID=""        # App ID de la integración ML
ML_CLIENT_SECRET=""    # Secret de la app
ML_USER_ID=""          # ID del seller (VAL ARG) — desambigua la fila de ml_credentials
ML_WEBHOOK_SECRET=""   # opcional: si está, se exige ?secret=... en la URL del callback
